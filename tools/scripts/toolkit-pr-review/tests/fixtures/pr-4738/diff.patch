+            .heartbeat(with_identity(
+                Request::new(HeartbeatRequest {
+                    gear_name: "billing".to_owned(),
+                    instance_id: owner_instance.clone(),
+                }),
+                sa_identity("catalog"),
+            ))
+            .await
+            .unwrap_err();
+        assert_eq!(hb.code(), tonic::Code::PermissionDenied);
