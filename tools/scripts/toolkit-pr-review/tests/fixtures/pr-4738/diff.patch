+            .deregister_instance(with_identity(
+                Request::new(DeregisterInstanceRequest {
+                    gear_name: "billing".to_owned(),
+                    instance_id: owner_instance.clone(),
+                }),
+                sa_identity("catalog"),
+            ))
+            .await
+            .unwrap_err();
